<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:live="using:Trag.Application.Live"
             x:Class="Trag.Desktop.Views.Workspace.NotificationBanners" x:DataType="live:StatusBarState" x:CompileBindings="True">
  <!-- Error, notice and repository warning above the file status; each appears only while it has text. -->
  <Grid RowDefinitions="Auto,Auto,Auto">
    <Border Name="ErrorBanner" IsVisible="{Binding HasError}" Background="{DynamicResource DangerTintBrush}" Padding="16,10"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12" /></Border>
    <Border Grid.Row="1" IsVisible="{Binding HasNotice}" Background="{DynamicResource NoticeTintBrush}" Padding="16,8"><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" /></Border>
    <Border Grid.Row="2" IsVisible="{Binding HasWarning}" Background="{DynamicResource WarningTintBrush}" Padding="16,8" MaxHeight="110"><ScrollViewer><TextBlock Text="{Binding RepositoryWarning}" TextWrapping="Wrap" FontSize="12" /></ScrollViewer></Border>
  </Grid>
</UserControl>
