<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Trag.ViewModels.Shell" xmlns:status="using:Trag.ViewModels.Status"
             xmlns:controls="using:Trag.Desktop.Controls"
             x:Class="Trag.Desktop.Views.Workspace.StagedFilesPanel" x:DataType="shell:FileStatusPage" x:CompileBindings="True">
  <!-- The staged files with their count and the Unstage action for the selection. -->
  <Grid RowDefinitions="Auto,*" ClipToBounds="True">
    <Border Padding="12,6" Background="{DynamicResource ChromeBrush}"><Grid ColumnDefinitions="*,Auto"><StackPanel Name="StagedHeading" Classes="heading"><TextBlock Text="Staged files" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><TextBlock Text="·" /><TextBlock Text="{Binding FileStatus.StagedFiles.Count}" /></StackPanel><Button Grid.Column="1" Name="UnstageButton" Content="{Binding Commit.UnstageActionText}" Command="{Binding Commit.UnstageSelectedCommand}" FontSize="11" Padding="8,4" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding Commit.UnstageTip}" /></Grid></Border>
    <controls:StatusListBox Focusable="True" Grid.Row="1" Name="StagedList" Classes="virtualized" ItemsSource="{Binding FileStatus.StagedFiles}" SelectedItem="{Binding FileStatus.SelectedStaged}" SelectedItems="{Binding FileStatus.StagedSelection, Mode=OneWay}" SelectionMode="Multiple" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Staged files">
      <ListBox.Styles><Style Selector="ListBoxItem" x:DataType="status:StatusRow"><Setter Property="AutomationProperties.Name" Value="{Binding PathText}" /></Style></ListBox.Styles>
      <ListBox.ItemTemplate><DataTemplate x:DataType="status:StatusRow">
        <Grid ColumnDefinitions="25,*" Background="Transparent" ToolTip.Tip="{Binding PathText}">
          <!-- A right-click opens the file, shows it in the file manager or copies its path, or looks it up: its history, or its
               lines blamed in the working tree. -->
          <Grid.ContextFlyout>
            <MenuFlyout FlyoutPresenterClasses="actions">
              <MenuItem Header="Open submodule" Command="{Binding $parent[UserControl].((shell:FileStatusPage)DataContext).Files.OpenSubmoduleCommand}" CommandParameter="{Binding File}" IsVisible="{Binding File.SubmoduleIsCheckedOut}"><MenuItem.Icon><controls:LineIcon Kind="open" /></MenuItem.Icon></MenuItem>
              <MenuItem Header="Open" Command="{Binding $parent[UserControl].((shell:FileStatusPage)DataContext).Files.OpenCommand}" CommandParameter="{Binding File.Path}" IsVisible="{Binding IsFile}"><MenuItem.Icon><controls:LineIcon Kind="external" /></MenuItem.Icon></MenuItem>
              <MenuItem Header="Open in File Explorer" Command="{Binding $parent[UserControl].((shell:FileStatusPage)DataContext).Files.RevealCommand}" CommandParameter="{Binding File.Path}" IsVisible="{Binding IsFile}"><MenuItem.Icon><controls:LineIcon Kind="folder" /></MenuItem.Icon></MenuItem>
              <MenuItem Header="Copy path" Command="{Binding $parent[UserControl].((shell:FileStatusPage)DataContext).Files.CopyPathCommand}" CommandParameter="{Binding File.Path}"><MenuItem.Icon><controls:LineIcon Kind="link" /></MenuItem.Icon></MenuItem>
              <Separator />
              <MenuItem Header="File history" Command="{Binding $parent[UserControl].((shell:FileStatusPage)DataContext).History.ShowStatusHistoryCommand}" CommandParameter="{Binding}"><MenuItem.Icon><controls:LineIcon Kind="history" /></MenuItem.Icon></MenuItem>
              <MenuItem Header="Blame" Command="{Binding $parent[UserControl].((shell:FileStatusPage)DataContext).Blame.BlameStatusCommand}" CommandParameter="{Binding}"><MenuItem.Icon><controls:LineIcon Kind="commit" /></MenuItem.Icon></MenuItem>
            </MenuFlyout>
          </Grid.ContextFlyout>
          <TextBlock Text="{Binding Code}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding PathText}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
    </controls:StatusListBox>
    <TextBlock Grid.Row="1" Text="No staged files" IsVisible="{Binding FileStatus.StagedEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Opacity="0.5" IsHitTestVisible="False" />
  </Grid>
</UserControl>
