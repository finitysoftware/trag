<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:repositories="using:Trag.ViewModels.Repositories"
             xmlns:controls="using:Trag.Desktop.Controls"
             x:Class="Trag.Desktop.Views.Repositories.LocalRepositoryList" x:DataType="repositories:RepositoryCatalogViewModel" x:CompileBindings="True">
  <!-- The local repositories group: header, one row per entry with its link state and actions, and the empty hint. -->
  <StackPanel Spacing="6">
    <Grid ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="FoldOnHeaderPress">
      <TextBlock Classes="group" Text="{Binding Local.LocalHeaderText}" />
      <Button Grid.Column="1" Name="LocalFoldButton" Classes="fold" Classes.open="{Binding Local.Fold.IsOpen}" Command="{Binding Local.Fold.ToggleCommand}" IsVisible="{Binding Filter.HasVisibleLocalRows}" AutomationProperties.Name="Fold the list"><controls:LineIcon Kind="chevron" Width="16" Height="16" /></Button>
    </Grid>
    <ListBox Name="LocalRepositoriesList" Classes="repos" IsVisible="{Binding Local.Fold.IsOpen}" ItemsSource="{Binding Filter.VisibleLocalRows}" SelectedItem="{Binding State.SelectedLocal}" DoubleTapped="OpenOnDoubleTap" AutomationProperties.Name="Local repositories">
      <ListBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding OpenSelectedRepositoryCommand}" /></ListBox.KeyBindings>
      <ListBox.Styles><Style Selector="ListBoxItem" x:DataType="repositories:LocalRepositoryRow"><Setter Property="AutomationProperties.Name" Value="{Binding Name}" /></Style></ListBox.Styles>
      <ListBox.ItemTemplate><DataTemplate x:DataType="repositories:LocalRepositoryRow">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
          <controls:LineIcon Kind="folder" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
          <Border Grid.Column="2" Classes="badge"><TextBlock Text="Local" /></Border>
          <Border Grid.Column="3" Classes="badge" Classes.ok="{Binding IsValid}" Classes.bad="{Binding IsBroken}"><StackPanel Orientation="Horizontal" Spacing="5"><controls:LineIcon Kind="check" Width="12" Height="12" IsVisible="{Binding IsValid}" Foreground="{DynamicResource DiffAddedBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding StatusText}" /></StackPanel></Border>
          <Button Grid.Column="4" Classes="kebab" Content="⋮" AutomationProperties.Name="Repository actions"><Button.Flyout><MenuFlyout>
            <MenuItem Header="Open" Command="{Binding $parent[UserControl].((repositories:RepositoryCatalogViewModel)DataContext).OpenEntryCommand}" CommandParameter="{Binding}" /><MenuItem Header="Reveal in Explorer" Command="{Binding $parent[UserControl].((repositories:RepositoryCatalogViewModel)DataContext).RevealCommand}" CommandParameter="{Binding}" /><MenuItem Header="Remove from list" Command="{Binding $parent[UserControl].((repositories:RepositoryCatalogViewModel)DataContext).Local.RequestRemoveRepositoryCommand}" CommandParameter="{Binding}" />
          </MenuFlyout></Button.Flyout></Button>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Classes="muted" IsVisible="{Binding !Filter.HasVisibleLocalRows}" Text="No local repositories here yet. Use New to add a folder, or clone one from an account below." Margin="12,4" />
  </StackPanel>
</UserControl>
