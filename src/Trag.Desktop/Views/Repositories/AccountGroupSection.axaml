<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:repositories="using:Trag.ViewModels.Repositories"
             xmlns:controls="using:Trag.Desktop.Controls"
             x:Class="Trag.Desktop.Views.Repositories.AccountGroupSection" x:DataType="repositories:RepositoryCatalogViewModel" x:CompileBindings="True">
  <!-- One group per account: its header with the load action, the message, and the hosted repositories once loaded; the hint without accounts. -->
  <StackPanel Spacing="20">
    <ItemsControl ItemsSource="{Binding AccountGroups}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="repositories:AccountGroup">
      <StackPanel Spacing="6" IsVisible="{Binding IsVisible}" Margin="0,0,0,12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Background="Transparent" PointerPressed="FoldOnHeaderPress">
          <controls:LineIcon Kind="{Binding IconKind}" Width="20" Height="20" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="group" Text="{Binding HeaderText}" />
          <Button Grid.Column="2" Command="{Binding LoadCommand}" Padding="12,6" AutomationProperties.Name="{Binding LoadText}"><StackPanel Orientation="Horizontal" Spacing="8"><controls:LineIcon Kind="cloud" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding LoadText}" FontSize="12" VerticalAlignment="Center" /></StackPanel></Button>
          <Button Grid.Column="3" Name="AccountFoldButton" Classes="fold" Classes.open="{Binding Fold.IsOpen}" Command="{Binding Fold.ToggleCommand}" IsVisible="{Binding HasVisibleRows}" AutomationProperties.Name="Fold the list"><controls:LineIcon Kind="chevron" Width="16" Height="16" /></Button>
        </Grid>
        <ProgressBar Classes="thin" IsVisible="{Binding IsLoading}" />
        <TextBlock Classes="muted" Text="{Binding Message}" IsVisible="{Binding HasMessage}" Margin="12,2" />
        <ListBox Classes="repos" IsVisible="{Binding Fold.IsOpen}" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}" DoubleTapped="OpenOnDoubleTap" AutomationProperties.Name="{Binding Title}">
          <ListBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding $parent[UserControl].((repositories:RepositoryCatalogViewModel)DataContext).ActivateRemoteCommand}" CommandParameter="{Binding SelectedRow}" /></ListBox.KeyBindings>
          <ListBox.Styles><Style Selector="ListBoxItem" x:DataType="repositories:RemoteRepositoryRow"><Setter Property="AutomationProperties.Name" Value="{Binding FullName}" /></Style></ListBox.Styles>
          <ListBox.ItemTemplate><DataTemplate x:DataType="repositories:RemoteRepositoryRow">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
              <controls:LineIcon Kind="{Binding IconKind}" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SubtitleText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
              <Border Grid.Column="2" Classes="badge ok" IsVisible="{Binding IsCloned}"><TextBlock Text="Cloned" /></Border>
              <Button Grid.Column="3" Classes="kebab" Content="⋮" AutomationProperties.Name="Repository actions"><Button.Flyout><MenuFlyout>
                <MenuItem Header="Open" Command="{Binding $parent[UserControl].((repositories:RepositoryCatalogViewModel)DataContext).OpenEntryCommand}" CommandParameter="{Binding Local}" IsVisible="{Binding IsCloned}" /><MenuItem Header="Clone" IsVisible="{Binding !IsCloned}" Command="{Binding $parent[UserControl].((repositories:RepositoryCatalogViewModel)DataContext).BeginCloneCommand}" CommandParameter="{Binding}" /><MenuItem Header="{Binding ViewText}" Command="{Binding $parent[UserControl].((repositories:RepositoryCatalogViewModel)DataContext).OpenWebCommand}" CommandParameter="{Binding}" />
              </MenuFlyout></Button.Flyout></Button>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Classes="muted" IsVisible="{Binding !HasAccounts}" Text="Add a GitHub or GitLab account in Settings → Integrations to list and clone its repositories here." Margin="0,4" />
  </StackPanel>
</UserControl>
