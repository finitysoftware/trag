<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:shell="using:Trag.ViewModels.Shell"
             xmlns:text="using:Trag.Domain.Presentation.Text"
             xmlns:controls="using:Trag.Desktop.Controls"
             xmlns:viewsMerge="using:Trag.Desktop.Views.Merge"
             x:Class="Trag.Desktop.Views.Rebase.RebaseView" x:DataType="shell:RebasePage" x:CompileBindings="True">
  <!-- A rebase in progress: the banner with the branch, where it goes and what is left; the plan of commits being replayed
       over the conflict panels shared with the merge view; the stopped commit's message with the markers notice, Abort,
       Skip and Continue. Every sentence comes from Domain through the view models. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <viewsMerge:OperationBanner Name="RebaseBanner" Title="{x:Static text:RebaseText.InProgress}" Direction="{Binding Rebase.Overview.Direction}" Remaining="{Binding Rebase.Overview.Remaining}"
                                Progress="{Binding Rebase.Overview.Progress}" ProgressText="{Binding Rebase.Overview.ProgressText}" IsAlarm="{Binding Rebase.Overview.HasMarkers}"
                                ReviewCommand="{Binding Navigator.ShowFileStatusCommand}" />

    <controls:RatioGrid Grid.Row="1" Ratio="{Binding Conflicts.Layout.DiffFilesRatio, Mode=TwoWay}">
      <Grid Name="RebaseFilesColumn" RowDefinitions="Auto,Auto,*" ClipToBounds="True">
        <Border Classes="mergeheading"><StackPanel Orientation="Horizontal" Spacing="6"><controls:LineIcon Kind="rebase" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /><TextBlock Text="COMMITS BEING REPLAYED ·" VerticalAlignment="Center" /><TextBlock Text="{Binding Rebase.Overview.Steps.Count}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></StackPanel></Border>
        <!-- The code-behind keeps the plan to about a third of the column; the conflicts below keep the rest. -->
        <ScrollViewer Grid.Row="1" Name="RebaseStepsScroller" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Name="RebaseSteps" ItemsSource="{Binding Rebase.Overview.Steps}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="text:RebaseStepLine">
              <Border Classes="rebasestep" Classes.current="{Binding IsCurrent}" Classes.waiting="{Binding IsWaiting}" ToolTip.Tip="{Binding Commit.Subject}">
                <Grid ColumnDefinitions="22,24,72,*,Auto" ColumnSpacing="4">
                  <controls:LineIcon Kind="check" Width="14" Height="14" Foreground="{DynamicResource DiffAddedBrush}" IsVisible="{Binding IsApplied}" VerticalAlignment="Center" />
                  <TextBlock Text="!" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" IsVisible="{Binding IsCurrent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource DividerBrush}" IsVisible="{Binding IsWaiting}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Number}" Classes="stepnumber" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Commit.ShortId}" Classes="stepid" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Commit.Subject}" Classes="stepsubject" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Note}" Classes="stepnote" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <viewsMerge:ConflictFilesPanel Grid.Row="2" DataContext="{Binding Conflicts}" Margin="0,4,0,0" />
      </Grid>
      <controls:PaneSplitter Grid.Column="1" AutomationProperties.Name="Resize conflict panels" ToolTip.Tip="Drag to resize · Double-click to restore" />
      <viewsMerge:ConflictDetailPanel Grid.Column="2" DataContext="{Binding Conflicts}" />
    </controls:RatioGrid>

    <Border Grid.Row="2" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,9">
      <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" IsVisible="{Binding !Rebase.Abort.IsOpen}">
          <TextBlock Text="{Binding Rebase.Overview.MessageCaption}" FontSize="11" TextTrimming="CharacterEllipsis" />
          <TextBox Grid.Row="1" Name="RebaseMessageEditor" Text="{Binding Rebase.Message}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="64" MaxLength="65536" IsEnabled="{Binding !Repository.IsWriting}" FontSize="12" PlaceholderText="Commit message" AutomationProperties.Name="Rebase commit message" />
          <viewsMerge:MarkersNotice Grid.Row="2" DataContext="{Binding Conflicts.Resolution}" />
          <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
            <Button Name="RequestAbortRebaseButton" Content="Abort rebase…" Command="{Binding Rebase.RequestAbortRebaseCommand}" FontSize="11" Padding="10,5" />
            <Button Grid.Column="1" Name="SkipCommitButton" Command="{Binding Rebase.SkipCommitCommand}" AutomationProperties.Name="Skip this commit" FontSize="11" Padding="10,5" ToolTip.Tip="Leave this commit out of the rebased branch and replay the rest. Aborting the rebase still brings it back.">
              <StackPanel Orientation="Horizontal" Spacing="6"><controls:LineIcon Kind="skip" Width="13" Height="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" /><TextBlock Text="Skip this commit" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <TextBlock Grid.Column="2" Name="ContinueHint" Text="{Binding Rebase.Overview.ContinueHint}" TextWrapping="Wrap" FontSize="10" Opacity="0.65" VerticalAlignment="Center" />
            <Button Grid.Column="3" Name="ContinueRebaseButton" Command="{Binding Rebase.ContinueRebaseCommand}" AutomationProperties.Name="Continue rebase" FontSize="12" Padding="14,6" ToolTip.Tip="Commit this commit with the message above and replay the rest">
              <StackPanel Orientation="Horizontal" Spacing="7"><controls:LineIcon Kind="arrow" Width="14" Height="14" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" /><TextBlock Text="Continue rebase" VerticalAlignment="Center" /></StackPanel>
            </Button>
          </Grid>
        </Grid>
        <StackPanel IsVisible="{Binding Rebase.Abort.IsOpen}" Spacing="10">
          <TextBlock Text="{x:Static text:RebaseText.AbortTitle}" FontWeight="SemiBold" FontSize="13" />
          <TextBlock Text="{Binding Rebase.Abort.Text}" TextWrapping="Wrap" FontSize="12" />
          <ProgressBar Classes="thin" IsVisible="{Binding Rebase.Abort.IsRunning}" />
          <TextBlock Text="{Binding Rebase.Abort.Message}" IsVisible="{Binding Rebase.Abort.Message, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DiffRemovedBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="10"><Button Name="KeepRebaseButton" Content="Keep rebase" Command="{Binding Rebase.Abort.CancelCommand}" FontSize="12" /><Button Name="ConfirmAbortRebaseButton" Classes="danger" Content="Abort this rebase" Command="{Binding Rebase.Abort.ConfirmCommand}" FontSize="12" /></StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
