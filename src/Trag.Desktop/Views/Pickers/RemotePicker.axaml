<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sync="using:Trag.ViewModels.Sync"
             xmlns:controls="using:Trag.Desktop.Controls"
             x:Class="Trag.Desktop.Views.Pickers.RemotePicker" x:DataType="sync:SyncViewModel" x:CompileBindings="True" Width="292">
  <!-- The remote Pull and Push use, the chosen one checked; choosing closes the picker. A repository has a few remotes, so
       there is no search. -->
  <StackPanel Spacing="8" Margin="16,15,16,12">
    <TextBlock Text="Choose the remote" FontWeight="SemiBold" FontSize="13" />
    <ItemsControl Name="RemoteList" ItemsSource="{Binding Selection.RemoteRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="sync:SyncRemoteRow">
      <Button Classes="branch plain" Classes.current="{Binding IsChosen}" Command="{Binding $parent[UserControl].((sync:SyncViewModel)DataContext).ChooseRemoteCommand}" CommandParameter="{Binding}">
        <Grid ColumnDefinitions="14,Auto,*" ColumnSpacing="10">
          <controls:LineIcon Kind="check" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsChosen}" />
          <controls:LineIcon Grid.Column="1" Kind="cloud" Width="15" Height="15" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
      </Button>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel>
</UserControl>
