<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:Trag.ViewModels.Shell"
             x:Class="Trag.Desktop.Views.Shell.ShellStatusBar" x:DataType="shell:ShellViewModel" x:CompileBindings="True">
  <!-- The bottom edge: the operation details log, the busy line, the status text with Details and Cancel, the watcher and Git version. -->
  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"><Grid RowDefinitions="Auto,2,Auto">
    <ScrollViewer Name="DetailsLog" MaxHeight="140" Margin="16,8" IsVisible="{Binding IsSyncDetailsExpanded}"><TextBlock Text="{Binding StatusBar.OperationDetails}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas,DejaVu Sans Mono,monospace" /></ScrollViewer>
    <ProgressBar Classes="thin" Grid.Row="1" IsVisible="{Binding Repository.IsBusy}" />
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="16,6">
      <TextBlock Text="{Binding StatusBar.Status}" ToolTip.Tip="{Binding StatusBar.Status}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <ToggleButton Grid.Column="1" Name="DetailsToggle" Content="Details" IsChecked="{Binding IsSyncDetailsExpanded}" IsVisible="{Binding StatusBar.HasOperationDetails}" FontSize="11" Padding="10,3" Margin="8,0" />
      <Button Grid.Column="2" Name="StatusCancelButton" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding ShowsCancel}" Padding="10,3" FontSize="11" />
      <TextBlock Grid.Column="3" Text="{Binding Session.Watcher.Status}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" Margin="16,0,0,0" />
      <TextBlock Grid.Column="4" Text="{Binding Header.GitVersionText}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" Margin="16,0,0,0" />
    </Grid>
  </Grid></Border>
</UserControl>
