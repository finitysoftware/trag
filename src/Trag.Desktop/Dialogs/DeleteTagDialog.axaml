<dialogs:DialogHost xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:Avalonia.Data.Converters"
                    xmlns:tags="using:Trag.ViewModels.Tags"
                    xmlns:behaviors="using:Trag.Desktop.Behaviors" xmlns:dialogs="using:Trag.Desktop.Dialogs"
                    x:Class="Trag.Desktop.Dialogs.DeleteTagDialog" x:DataType="tags:TagsViewModel" x:CompileBindings="True"
                    IsOpen="{Binding Delete.IsOpen}" CloseCommand="{Binding Delete.CancelCommand}"
                    Title="{Binding DeleteTitle}" Subtitle="{Binding Delete.Text}"
                    Icon="trash" IconBrush="{DynamicResource DiffRemovedBrush}" PlateBrush="{DynamicResource DangerTintBrush}"
                    behaviors:FocusOnOpen.Target="{Binding #CancelDeleteTagButton}">
  <!-- The tag goes here; with a remote it can go there too, which is asked for explicitly, since a fetch brings back
       what the remote still has. -->
  <StackPanel Spacing="12">
    <Separator />
    <CheckBox Name="DeleteTagOnRemoteBox" Content="{Binding DeleteOnRemoteLabel}" IsChecked="{Binding DeleteOnRemote}" IsVisible="{Binding CanPushTags}" FontSize="12" />
    <TextBlock Name="DeleteTagOnRemoteHint" Text="{Binding DeleteOnRemoteHint}" IsVisible="{Binding ShowsDeleteOnRemoteHint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
    <ProgressBar Classes="thin" IsVisible="{Binding Delete.IsRunning}" />
    <TextBlock Text="{Binding Delete.Message}" IsVisible="{Binding Delete.Message, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" FontSize="12" Foreground="{DynamicResource DiffRemovedBrush}" TextWrapping="Wrap" />
    <Separator />
  </StackPanel>
  <dialogs:DialogHost.Footer>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Name="CancelDeleteTagButton" Content="Cancel" Command="{Binding Delete.CancelCommand}" Padding="18,8" />
      <Button Name="ConfirmDeleteTagButton" Classes="danger" Content="Delete" Command="{Binding Delete.ConfirmCommand}" Padding="18,8" />
    </StackPanel>
  </dialogs:DialogHost.Footer>
</dialogs:DialogHost>
