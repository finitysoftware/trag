<dialogs:DialogHost xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:Avalonia.Data.Converters"
                    xmlns:stash="using:Trag.ViewModels.Stash"
                    xmlns:behaviors="using:Trag.Desktop.Behaviors" xmlns:dialogs="using:Trag.Desktop.Dialogs"
                    x:Class="Trag.Desktop.Dialogs.DropStashDialog" x:DataType="stash:StashViewModel" x:CompileBindings="True"
                    IsOpen="{Binding Drop.IsOpen}" CloseCommand="{Binding Drop.CancelCommand}"
                    Title="Drop stash" Subtitle="{Binding Drop.Text}"
                    Icon="trash" IconBrush="{DynamicResource DiffRemovedBrush}" PlateBrush="{DynamicResource DangerTintBrush}"
                    behaviors:FocusOnOpen.Target="{Binding #CancelDropStashButton}">
  <!-- Dropping a stash has no undo in Trag, so it asks like deleting a branch. -->
  <StackPanel Spacing="12">
    <Separator />
    <TextBlock Text="The entry leaves the stash list. Git keeps its commit unreferenced for a while, but Trag has no undo for this." FontSize="12" TextWrapping="Wrap" />
    <ProgressBar Classes="thin" IsVisible="{Binding Drop.IsRunning}" />
    <TextBlock Text="{Binding Drop.Message}" IsVisible="{Binding Drop.Message, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" FontSize="12" Foreground="{DynamicResource DiffRemovedBrush}" TextWrapping="Wrap" />
    <Separator />
  </StackPanel>
  <dialogs:DialogHost.Footer>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Name="CancelDropStashButton" Content="Cancel" Command="{Binding Drop.CancelCommand}" Padding="18,8" />
      <Button Name="ConfirmDropStashButton" Classes="danger" Content="Drop" Command="{Binding Drop.ConfirmCommand}" Padding="18,8" />
    </StackPanel>
  </dialogs:DialogHost.Footer>
</dialogs:DialogHost>
