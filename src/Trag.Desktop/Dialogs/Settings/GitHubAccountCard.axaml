<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accounts="using:Trag.ViewModels.Accounts"
             xmlns:text="using:Trag.Domain.Presentation.Text"
             x:Class="Trag.Desktop.Dialogs.Settings.GitHubAccountCard" x:DataType="accounts:AccountsViewModel" x:CompileBindings="True">
  <!-- GitHub: sign in through the browser device flow; each connected account can be checked or removed,
       the removal confirmed on its own row. -->
  <Border Classes="card"><StackPanel Spacing="12">
    <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
      <Path Width="30" Height="30" Stretch="Uniform" Fill="{DynamicResource TextControlForeground}" VerticalAlignment="Center" Data="M8,0 C3.58,0 0,3.58 0,8 C0,11.54 2.29,14.53 5.47,15.59 C5.87,15.66 6.02,15.42 6.02,15.21 C6.02,15.02 6.01,14.39 6.01,13.72 C4,14.09 3.48,13.23 3.32,12.78 C3.23,12.55 2.84,11.84 2.5,11.65 C2.22,11.5 1.82,11.13 2.49,11.12 C3.12,11.11 3.57,11.7 3.72,11.94 C4.44,13.15 5.59,12.81 6.05,12.6 C6.12,12.08 6.33,11.73 6.56,11.53 C4.78,11.33 2.92,10.64 2.92,7.58 C2.92,6.71 3.23,5.99 3.74,5.43 C3.66,5.23 3.38,4.41 3.82,3.31 C3.82,3.31 4.49,3.1 6.02,4.13 C6.66,3.95 7.34,3.86 8.02,3.86 C8.7,3.86 9.38,3.95 10.02,4.13 C11.55,3.09 12.22,3.31 12.22,3.31 C12.66,4.41 12.38,5.23 12.3,5.43 C12.81,5.99 13.12,6.7 13.12,7.58 C13.12,10.65 11.25,11.33 9.47,11.53 C9.76,11.78 10.01,12.26 10.01,13.01 C10.01,14.08 10,14.94 10,15.21 C10,15.42 10.15,15.67 10.55,15.59 C13.71,14.53 16,11.53 16,8 C16,3.58 12.42,0 8,0 Z" />
      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="GitHub" FontWeight="SemiBold" FontSize="15" /><TextBlock Classes="muted" Text="Sign in securely in your browser" /></StackPanel>
      <Button Grid.Column="2" Name="AddGitHubButton" Content="Add account  +" Command="{Binding AddGitHubCommand}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" />
    </Grid>
    <ItemsControl ItemsSource="{Binding GitHubAccounts}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="text:AccountRow">
      <Border BorderBrush="{DynamicResource SettingsLine}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel Spacing="6">
        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="{Binding StorageText}" /><TextBlock Classes="muted" Text="{Binding IdentityText}" />
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,0">
          <Button Content="Check connection" Command="{Binding $parent[ItemsControl].((accounts:AccountsViewModel)DataContext).VerifyAccountCommand}" CommandParameter="{Binding Account}" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button Content="Remove" IsVisible="{Binding !ConfirmsRemoval}" Command="{Binding $parent[ItemsControl].((accounts:AccountsViewModel)DataContext).RequestRemovalCommand}" CommandParameter="{Binding Account}" />
            <Button Content="Cancel" IsVisible="{Binding ConfirmsRemoval}" Command="{Binding $parent[ItemsControl].((accounts:AccountsViewModel)DataContext).KeepAccountCommand}" />
            <Button Content="Confirm" Classes="accent" IsVisible="{Binding ConfirmsRemoval}" Command="{Binding $parent[ItemsControl].((accounts:AccountsViewModel)DataContext).ConfirmRemovalCommand}" />
          </StackPanel>
        </Grid>
      </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
</UserControl>
