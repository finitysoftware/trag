<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:setup="using:Trag.ViewModels.Setup"
             xmlns:text="using:Trag.Domain.Presentation.Text"
             x:Class="Trag.Desktop.Dialogs.Settings.GitPage" x:DataType="setup:GitSettingsViewModel" x:CompileBindings="True">
  <!-- Settings -> Git: the Git Trag runs, where it was found and what it brings, a label and a value each; Choose git.exe,
       and the way back to the Git Trag finds once one was chosen. -->
  <StackPanel Spacing="16">
    <StackPanel Spacing="5"><TextBlock Text="Git" FontSize="21" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="The Git Trag runs for every repository." /></StackPanel>
    <Border Classes="card"><StackPanel Spacing="12">
      <ItemsControl ItemsSource="{Binding Facts}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="text:DetailFact">
          <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
            <TextBlock Classes="muted" Text="{Binding Label}" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="muted" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Name="ForgetGitChoiceButton" Content="Use the Git Trag finds" Command="{Binding ForgetChoiceCommand}" IsVisible="{Binding IsChosen}" />
        <Button Name="ChooseGitButton" Content="Choose git.exe" Click="ChooseGit" />
      </StackPanel>
    </StackPanel></Border>
  </StackPanel>
</UserControl>
