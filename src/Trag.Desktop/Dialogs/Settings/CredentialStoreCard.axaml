<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:accounts="using:Trag.ViewModels.Accounts"
             x:Class="Trag.Desktop.Dialogs.Settings.CredentialStoreCard" x:DataType="accounts:AccountsViewModel" x:CompileBindings="True">
  <!-- Where tokens are kept: the platform store's state, the memory-only choice, and a retry when the store was unavailable. -->
  <StackPanel Spacing="10"><TextBlock Classes="muted" Text="{Binding VaultText}" /><CheckBox Content="Remember only until Trag closes" IsChecked="{Binding MemoryOnly}" IsEnabled="{Binding IsIdle}" FontSize="12" /><Button Content="Retry credential store" Command="{Binding RetryStorageCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" /></StackPanel>
</UserControl>
