<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Trag.Desktop.Controls">
  <!-- Pieces the dialogs share: two-way choice buttons, field captions and text links. -->
  <Style Selector="Button.choice"><Setter Property="Padding" Value="12,8" /><Setter Property="FontSize" Value="12" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button.choice.active"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.link"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="Button.link:pointerover"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="TextBlock.field"><Setter Property="FontSize" Value="13" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <!-- The merge dialog: tinted boxes for what stops the merge, what it will conflict on and where Trag goes, the preview
       card, the Swap pill between the two branches, and the tag that marks the current branch. -->
  <Style Selector="Border.mergebox"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,11" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Border.mergebox.blocked"><Setter Property="Background" Value="{DynamicResource DangerTintBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DangerTintBrush}" /></Style>
  <Style Selector="Border.mergebox.conflict"><Setter Property="Background" Value="{DynamicResource WarningTintBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WarningTintBrush}" /></Style>
  <Style Selector="Border.mergebox.notice"><Setter Property="Background" Value="{DynamicResource NoticeTintBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource NoticeTintBrush}" /></Style>
  <Style Selector="Border.mergepreview"><Setter Property="CornerRadius" Value="8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /><Setter Property="Background" Value="{DynamicResource ChromeBrush}" /></Style>
  <Style Selector="Button.swap"><Setter Property="Background" Value="{DynamicResource ControlBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="6,2,8,2" /><Setter Property="FontSize" Value="10.5" /></Style>
  <Style Selector="Border.currentpill"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="7,1" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
  <!-- The Merge | Rebase switch at the top of the merge dialog, and the current branch where the rebase side cannot change it. -->
  <Style Selector="Border.segmented"><Setter Property="Background" Value="{DynamicResource ChromeBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="3" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
  <Style Selector="Button.segment"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="18,6" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Button.segment controls|LineIcon"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="Button.segment.selected"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.segment.selected controls|LineIcon"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.fixedchoice"><Setter Property="Background" Value="{DynamicResource ChromeBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="11,0" /><Setter Property="MinHeight" Value="32" /></Style>
  <Style Selector="Border.currentpill TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
</Styles>
