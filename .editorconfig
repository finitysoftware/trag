root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,axaml,csproj,props}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0005.severity = warning
csharp_preserve_single_line_statements = false

# Git's own output, trailing spaces included
[tests/Trag.Infrastructure.UnitTests/Git/Diagnostics/FailureTextCorpus/*.txt]
trim_trailing_whitespace = false
